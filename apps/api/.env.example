# The API's write token.
#
# Any long random string. Must equal STREAMKIT_API_TOKEN on the frontend.
# Sent as `X-StreamKit-Token`; every POST/PATCH/PUT/DELETE is refused without
# it. Reads, the WebSocket, and /overlay/* stay open because OBS cannot send a
# header.
#
# Unset means the whole API is writable by anyone. That is deliberate so a fresh
# clone runs with no setup — but it is not a deployment state. On the server this
# lives in /etc/streamkit/env (mode 600), read by the systemd unit, never
# written inline into the unit file.
STREAMKIT_TOKEN=

# Bind address. 0.0.0.0 because nginx reaches this from outside; the firewall
# is what limits who can connect.
HOST=0.0.0.0
PORT=8000
