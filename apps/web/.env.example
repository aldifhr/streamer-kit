# Where the API lives.
#
# Read at BUILD time — NEXT_PUBLIC_* values are inlined into the client bundle,
# so changing this needs a rebuild, not just a restart.
#
# Must stay a NEXT_PUBLIC_ value: the WebSocket bypasses the rewrite (Next does
# not proxy WS upgrades), so the browser needs the origin to open the socket
# itself. A hostname is not a credential, so inlining it costs nothing.
#
# Leave unset for local development and the frontend talks to
# http://localhost:8000 with the npm run dev:api server.
NEXT_PUBLIC_API_URL=https://kit-backend.aldifhr.my.id

# The API's write token. Attached by the route handler in app/api/[...path].
#
# Must match STREAMKIT_TOKEN on the API. Writes are rejected without it.
#
# No NEXT_PUBLIC_ prefix on purpose: a prefixed value is inlined into the client
# bundle, where anyone who loads the page can read it. Unprefixed, it is read
# only while building and rides the proxy hop, so the browser never sees it.
#
# The overlay page loads in OBS and calls /api/connect, which is a write — so
# if the API expects a token and this build has none, the overlay never connects
# and the source stays blank. The editor will say so, and the overlay shows a
# small red notice, but the fix is to set this and rebuild.
#
# Still build-time: rotating the API token means a rebuild, not a restart.
# Leave unset for local development — the API is open when it has no token, so a
# fresh clone works with no setup.
STREAMKIT_API_TOKEN=

# The dashboard password. Without it the proxy fails closed with a 503 rather
# than opening up, so a deploy that forgot this is unusable rather than wide
# open — set it before the first real deploy.
STREAMKIT_PASSWORD=

# HMAC key for the session cookie. Any long random string. Rotating it logs
# everyone out.
STREAMKIT_SESSION_SECRET=
