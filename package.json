{
  "name": "stream-kit",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:api": "cd apps/api && python main.py",
    "build": "cd apps/web && bun run build",
    "start": "cd apps/web && bun run start",
    "test:api": "cd apps/api && python test_api.py",
    "test:astro": "tsc -p apps/web/tests/tsconfig.engine.json && node apps/web/tests/astro-engine.cjs",
    "test:astro-consume": "tsc -p apps/web/tests/tsconfig.consume.json && node apps/web/tests/astro-consume.cjs",
    "test:registry": "tsc -p apps/web/tests/tsconfig.registry.json && node apps/web/tests/widget-registry.cjs",
    "test:scene": "tsc -p apps/web/tests/tsconfig.scene.json && node apps/web/tests/scene-ids.cjs",
    "test:align": "tsc -p apps/web/tests/tsconfig.align.json && node apps/web/tests/alignment.cjs",
    "test:middleware": "tsc -p apps/web/tests/tsconfig.middleware.json && node apps/web/tests/middleware.cjs",
    "test:socketlog": "tsc -p apps/web/tests/tsconfig.socketlog.json && node apps/web/tests/socket-log.cjs",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test:astro-three": "tsc -p apps/web/tests/tsconfig.three.json && node apps/web/tests/astro-three.cjs",
    "test:astro-caps": "tsc -p apps/web/tests/tsconfig.engine.json && node apps/web/tests/astro-caps.cjs",
    "test:preview-fetch": "node apps/web/tests/preview-fetch.cjs",
    "test:astro-motion": "tsc -p apps/web/tests/tsconfig.engine.json && node apps/web/tests/astro-motion.cjs",
    "test:astro-fade": "tsc -p apps/web/tests/tsconfig.engine.json && node apps/web/tests/astro-fade.cjs",
    "test:city": "tsc -p apps/web/tests/tsconfig.city.json && node apps/web/tests/city-engine.cjs",
    "test:jar": "tsc -p apps/web/tests/tsconfig.consume.json && node apps/web/tests/donation-jar.cjs",
    "test:poll": "tsc -p apps/web/tests/tsconfig.consume.json && node apps/web/tests/poll-vote.cjs",
    "test:feed": "tsc -p apps/web/tests/tsconfig.feed.json && node apps/web/tests/feed-contract.cjs",
    "test:isolation": "apps/api/.venv/bin/python -u apps/api/tests/test_overlay_isolation.py",
    "test:editor": "tsc -p apps/web/tests/tsconfig.scene.json && node apps/web/tests/editor-scene-load.cjs",
    "test:city-audience": "npm run test:city && node apps/web/tests/city-audience.cjs",
    "test:city-tiers": "npm run test:city && node apps/web/tests/city-tiers.cjs",
    "test:city-feed": "tsc -p apps/web/tests/tsconfig.feed.json && node apps/web/tests/city-subscription.cjs",
    "test:city-inspector": "npm run test:city && node apps/web/tests/city-inspector.cjs"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.4.0"
  }
}